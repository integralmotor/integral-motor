rules_version = '2';
// Reglas de la base de datos de Integral Motor.
// Entran: el administrador (con Google), las cuentas de Google habilitadas y los usuarios con contraseña creados desde la app.
service cloud.firestore {
  match /databases/{database}/documents {
    function google() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email_verified == true;
    }
    function admin() {
      return google() && request.auth.token.email.lower() == 'rectificacionesim@gmail.com';
    }
    function lista() {
      return get(/databases/$(database)/documents/config/usuarios).data;
    }
    function habilitado() {
      return admin() || (request.auth != null
        && exists(/databases/$(database)/documents/config/usuarios)
        && ((google() && request.auth.token.email.lower() in lista().get('emails', []))
            || (request.auth.token.firebase.sign_in_provider == 'password' && request.auth.uid in lista().get('uids', []))));
    }
    // lista de usuarios y permisos: la ven todos los habilitados, la cambia solo el administrador
    match /config/usuarios {
      allow read: if habilitado();
      allow write: if admin();
    }
    // todo lo demás (presupuestos, clientes, caja, stock, precios...)
    match /{coleccion}/{id} {
      allow read, write: if habilitado() && !(coleccion == 'config' && id == 'usuarios');
    }
  }
}
